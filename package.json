{
  "name": "openclaw-diag-cli",
  "version": "1.7.0",
  "description": "OpenClaw observer-only diagnostic CLI. Zero-dependency Python scripts wrapped in Node for npx-friendly install.",
  "keywords": [
    "openclaw",
    "diagnostic",
    "cli",
    "ops",
    "troubleshooting",
    "ai-agent"
  ],
  "homepage": "https://github.com/wujiaming88/openclaw-diag-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wujiaming88/openclaw-diag-cli.git"
  },
  "bugs": {
    "url": "https://github.com/wujiaming88/openclaw-diag-cli/issues"
  },
  "license": "MIT",
  "author": "wujiaming88",
  "bin": {
    "openclaw-diag": "./bin/openclaw-diag.js"
  },
  "files": [
    "bin/openclaw-diag.js",
    "bin/ocdiag",
    "ocdiag/*.py",
    "ocdiag/core/*.py",
    "ocdiag/collectors/*.py",
    "ocdiag/inspectors/*.py",
    "ocdiag/render/*.py",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "skill/openclaw-diag/SKILL.md",
    "scripts/install-skill.py"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node bin/openclaw-diag.js list && echo OK"
  }
